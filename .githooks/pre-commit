#!/bin/bash
# Pre-commit hook: syntax checks + auto-increment VERSION.

set -euo pipefail

VER_FILE="VERSION"

# ── Syntax checks ─────────────────────────────────────────────────────────────

fail=0

staged_py=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
for f in $staged_py; do
    if ! py_err=$(python3 -m py_compile "$f" 2>&1); then
        echo "[pre-commit] ✗ Python syntax error in $f:"
        echo "$py_err"
        fail=1
    fi
done

staged_sh=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)
for f in $staged_sh; do
    if ! sh_err=$(bash -n "$f" 2>&1); then
        echo "[pre-commit] ✗ Bash syntax error in $f:"
        echo "$sh_err"
        fail=1
    fi
done

NODE_BIN=$(command -v node 2>/dev/null || echo "/opt/homebrew/bin/node")
staged_js=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' || true)
for f in $staged_js; do
    if ! js_err=$("$NODE_BIN" --check "$f" 2>&1); then
        echo "[pre-commit] ✗ JS syntax error in $f:"
        echo "$js_err"
        fail=1
    fi
done

if [[ $fail -ne 0 ]]; then
    echo "[pre-commit] Commit blocked due to syntax errors above."
    exit 1
fi

echo "[pre-commit] Syntax checks passed ✓"

# ── Submodule push check ──────────────────────────────────────────────────────

# Check if frontend submodule has unpushed changes when staging submodule pointer
if git diff --cached --name-only | grep -q '^frontend$'; then
    if [[ -d frontend/.git ]]; then
        cd frontend
        # Check if local commits exist that aren't on remote
        unpushed=$(git log origin/main..HEAD --oneline 2>/dev/null || true)
        if [[ -n "$unpushed" ]]; then
            echo "[pre-commit] ✗ ERROR: frontend submodule has unpushed commits:"
            echo "$unpushed"
            echo ""
            echo "GitHub Actions builds cs-webui directly from GitHub, not from the submodule."
            echo "Push frontend changes first:"
            echo "  cd frontend && git push origin main"
            cd ..
            exit 1
        fi
        cd ..
    fi
fi

# ── Version bump ──────────────────────────────────────────────────────────────

staged_non_ver=$(git diff --cached --name-only --diff-filter=ACM | grep -v '^VERSION$' || true)
if [[ -z "$staged_non_ver" ]]; then
    echo "[pre-commit] Only VERSION staged — skipping re-bump"
    exit 0
fi

current=$(cat "$VER_FILE" 2>/dev/null | tr -d '[:space:]')
if [[ -z "$current" ]]; then
    echo "[pre-commit] WARNING: VERSION not found — skipping bump"
    exit 0
fi

new=$(awk -v v="$current" 'BEGIN { printf "%.2f", v + 0.01 }')
echo "[pre-commit] Bumping version $current → $new"
echo "$new" > "$VER_FILE"
git add "$VER_FILE"
