# Hub Central Platform — Environment Configuration
# Copy to .env for local development or use as a reference for container/systemd env vars.

# ── Network ───────────────────────────────────────────────────────
# HTTPS listener port exposed by Docker Compose / BYOD installs.
HUB_PORT=8443

# ── Security ──────────────────────────────────────────────────────
# Fernet key for secrets at rest.
# REQUIRED in production.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBUI_SECRET_KEY=

# JWT signing key.
# REQUIRED in production.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# JWT settings.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Admin Bootstrap ───────────────────────────────────────────────
FIRST_ADMIN_USERNAME=admin
# ADMIN_PASSWORD is the preferred bootstrap password variable.
ADMIN_PASSWORD=changeme
# Optional legacy alias supported by app/config.py.
# FIRST_ADMIN_PASSWORD=changeme

# ── Data & TLS ────────────────────────────────────────────────────
# Local default is ./data. In containers, set DATA_DIR=/data.
DATA_DIR=./data

# Optional: provide your own TLS cert/key (PEM format).
# If unset, a self-signed cert is generated under DATA_DIR/tls/.
# TLS_CERT_PATH=/data/tls/cert.pem
# TLS_KEY_PATH=/data/tls/key.pem

# ── OpenID Connect (stub) ─────────────────────────────────────────
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── LDAP (stub) ───────────────────────────────────────────────────
LDAP_ENABLED=false
LDAP_URL=ldap://your-ldap-server
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=

# ── RADIUS (stub) ─────────────────────────────────────────────────
RADIUS_ENABLED=false
RADIUS_HOST=
RADIUS_PORT=1812
RADIUS_SECRET=
